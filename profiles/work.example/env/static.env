# Sourced by $ZDOTDIR/.zshenv on work-mac, so non-interactive shells get these
# too. No secrets. aqua reads its private registry through ghtkn, with the
# read app; GITHUB_TOKEN, AQUA_GITHUB_TOKEN and AQUA_KEYRING_ENABLED stay unset,
# or aqua ignores ghtkn.
export AQUA_GHTKN_ENABLED=true
export GHTKN_APP=example-org/read
