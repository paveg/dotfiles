# Host blocks go before Host *: ssh keeps the first value it obtains for a key.
Host pve
  HostName 192.168.10.5
  User root
  IdentityFile ~/.ssh/pve_ed25519.pub
  IdentitiesOnly yes
  ForwardAgent no
  HostKeyAlias pve
  StrictHostKeyChecking yes

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
