{
  "db": {
    "rules": {
      "prisma-migrate-reset": {
        "tier": "deny",
        "fixtures": [
          "npx prisma migrate reset --force",
          "npx prisma migrate  reset"
        ],
        "near_miss": [
          "npx prisma migrate resetx"
        ],
        "boundary": [
          "npx prisma migrate reset;echo done"
        ]
      },
      "prisma-push-force-reset": {
        "tier": "deny",
        "fixtures": [
          "npx prisma db push --force-reset",
          "npx prisma db  push --force-reset"
        ],
        "near_miss": [
          "npx prisma db push --force-resetx"
        ],
        "boundary": [
          "npx prisma db push --force-reset;echo done"
        ]
      },
      "drizzle-push-force": {
        "tier": "deny",
        "fixtures": [
          "pnpm drizzle-kit push --force"
        ],
        "near_miss": [
          "pnpm drizzle-kit push --forcex"
        ],
        "boundary": [
          "pnpm drizzle-kit push --force;echo done"
        ]
      },
      "rails-db-setup": {
        "tier": "deny",
        "fixtures": [
          "bin/rails db:setup",
          "bundle exec rake db:schema:load"
        ],
        "near_miss": [
          "bin/rails db:setupx"
        ],
        "boundary": [
          "bin/rails db:setup;echo done"
        ]
      },
      "django-flush": {
        "tier": "deny",
        "fixtures": [
          "python manage.py flush",
          "python manage.py reset_db"
        ],
        "near_miss": [
          "python manage.py flushed"
        ],
        "boundary": [
          "python manage.py flush;echo done"
        ]
      },
      "sequelize-undo-all": {
        "tier": "deny",
        "fixtures": [
          "npx sequelize db:migrate:undo:all"
        ],
        "near_miss": [
          "npx sequelize db:migrate:undo:allx"
        ],
        "boundary": [
          "npx sequelize db:migrate:undo:all;echo done"
        ]
      },
      "typeorm-schema-drop": {
        "tier": "deny",
        "fixtures": [
          "npx typeorm schema:drop"
        ],
        "near_miss": [
          "npx typeorm schema:dropx"
        ],
        "boundary": [
          "npx typeorm schema:drop;echo done"
        ]
      },
      "knex-rollback-all": {
        "tier": "deny",
        "fixtures": [
          "npx knex migrate:rollback --all",
          "npx knex --knexfile db.js migrate:rollback --all"
        ],
        "near_miss": [
          "npx knex migrate:rollback --allx"
        ],
        "boundary": [
          "npx knex migrate:rollback --all;echo done"
        ]
      },
      "script-db-wipe": {
        "tier": "deny",
        "fixtures": [
          "pnpm run db:reset",
          "npx sequelize db:drop",
          "pnpm run db:nuke",
          "pnpm run db:wipe",
          "pnpm run db:clear"
        ],
        "near_miss": [
          "pnpm run db:resetx"
        ],
        "boundary": [
          "pnpm run db:reset;echo done",
          "pnpm run api:db:reset"
        ]
      },
      "dropdb": {
        "tier": "deny",
        "fixtures": [
          "dropdb app_dev",
          "sudo -u postgres dropdb app"
        ],
        "near_miss": [
          "echo mydropdb",
          "echo dropdbx"
        ],
        "boundary": [
          "/usr/bin/dropdb app_dev",
          "dropdb;echo done"
        ]
      },
      "mysqladmin-drop": {
        "tier": "deny",
        "fixtures": [
          "mysqladmin drop app",
          "mysqladmin -u root drop app"
        ],
        "near_miss": [
          "mysqladmin dropx app",
          "mysqladmin status"
        ],
        "boundary": [
          "mysqladmin drop;echo done"
        ]
      },
      "drop-database": {
        "tier": "deny",
        "fixtures": [
          "psql -c \"DROP DATABASE app_dev\"",
          "psql -d app_dev -c 'dro\"p data\"base app_dev'",
          "psql -d app_dev -c \"DROP\nDATABASE app_dev\"",
          "psql -d app_dev -c 'DROP/**/DATABASE app_dev'",
          "pgcli -c 'DROP--wipe\n  DATABASE app_dev'",
          "psql -d app_dev -c \"DRO\\\nP DATA\\\nBASE app_dev\"",
          "psql -d app_dev -c \"DROP\n\nDATABASE app_dev\"",
          "psql -d app_dev -c 'DROP\\\nDATABASE app_dev'",
          "psql -d app_dev <<'EOF'\nDROP\\\nDATABASE app_dev;\nEOF",
          "psql -d app_dev -c 'DROP\\\nDATABASE app_dev' -v x=\"$y\"",
          "pgcli -c 'DROP --\\\nDATABASE app_dev'",
          "psql -d app_dev -c 'DROP--wipe-it\nDATABASE app_dev'",
          "psql -d app_dev -c 'DROP /* a b */ DATABASE app_dev'"
        ],
        "near_miss": [
          "psql -c \"DROP DATABASEX\""
        ],
        "boundary": [
          "psql -c \"DROP DATABASE;\""
        ]
      },
      "drop-schema": {
        "tier": "deny",
        "fixtures": [
          "psql -d app_dev -c 'DROP SCHEMA public'"
        ],
        "near_miss": [
          "psql -c \"DROP SCHEMAS\""
        ],
        "boundary": [
          "psql -c \"DROP SCHEMA;\""
        ]
      },
      "drop-table": {
        "tier": "deny",
        "fixtures": [
          "psql -d app_dev -c 'DROP TABLE users'"
        ],
        "near_miss": [
          "git commit -m \"drop tables of content\""
        ],
        "boundary": [
          "psql -c \"DROP TABLE;\""
        ]
      },
      "truncate": {
        "tier": "deny",
        "fixtures": [
          "psql -d app_dev -c 'TRUNCATE TABLE users'",
          "truncate -s 0 app.log",
          "pgcli -c \"TRUN\\\nCATE users\""
        ],
        "near_miss": [
          "echo truncated",
          "git status"
        ],
        "boundary": [
          "echo truncate;"
        ]
      },
      "drop-expansion": {
        "tier": "ask",
        "fixtures": [
          "pgcli -c \"DROP${IFS}DATABASE app_dev\""
        ],
        "near_miss": [
          "echo mydrop*"
        ],
        "boundary": [
          "echo /drop/$x"
        ]
      },
      "drop-expansion-reversed": {
        "tier": "ask",
        "fixtures": [
          "echo {DROP,DATABASE} app_dev"
        ],
        "near_miss": [
          "echo $x mydrop"
        ],
        "boundary": [
          "echo $x/drop"
        ]
      },
      "client-construct": {
        "tier": "ask",
        "fixtures": [
          "psql -d app_dev -c \"$SQL\"",
          "mysql -e `cat query.sql`",
          "mariadb -e 'select * from users'",
          "sqlite3 app.db .t?bles",
          "prisma validate sch[1]ema.cfg",
          "drizzle-kit studio {a,b}",
          "pg_restore --list dump.tar",
          "pnpm run db:migrate -- --verbose",
          "mysql -e 'DROP # c\nDATABASE app'"
        ],
        "near_miss": [
          "psql -d app_dev",
          "echo mypsql $SQL"
        ],
        "boundary": [
          "/usr/bin/psql -c \"$SQL\""
        ]
      },
      "client-construct-reversed": {
        "tier": "ask",
        "fixtures": [
          "echo '# header' | mysql -D app",
          "echo \"$SQL\" | psql -d app_dev",
          "echo `cat query.sql` | mysql -D app",
          "cat query* | mariadb app",
          "echo ? | sqlite3 app.db",
          "echo [x] | prisma validate",
          "echo {a,b} | drizzle-kit studio",
          "echo -- | pg_restore -d app",
          "echo $x && pnpm run db:migrate"
        ],
        "near_miss": [
          "echo $SQL | mypsql"
        ],
        "boundary": [
          "echo $SQL|/usr/bin/psql"
        ]
      },
      "client-after-brace": {
        "tier": "ask",
        "fixtures": [
          "echo {psql,x}",
          "echo {mysql,x}",
          "echo {mariadb,x}",
          "echo {sqlite3,x}",
          "echo {prisma,x}",
          "echo {drizzle-kit,x}",
          "echo {pg_restore,x}",
          "pnpm run {db:res,x}et"
        ],
        "near_miss": [
          "echo {xpsql,y}",
          "echo {x,mypsql}"
        ]
      }
    },
    "deny": {
      "prisma-reset": "npx prisma migrate reset --force",
      "script-wrapper": "pnpm run db:reset",
      "rails-schema": "bin/rails db:schema:load",
      "postgres-cli": "dropdb app_dev",
      "sql-wipe-uppercase": "psql -d app_dev -c 'TRUNCATE TABLE users'",
      "sql-drop-db": "psql -c \"DROP DATABASE app_dev\"",
      "quote-split": "psql -d app_dev -c 'dro\"p data\"base app_dev'",
      "multiline": "psql -d app_dev -c \"DROP\n  DATABASE app_dev\"",
      "multiline-no-indent": "psql -d app_dev -c \"DROP\nDATABASE app_dev\"",
      "single-table": "psql -d app_dev -c 'DROP TABLE users'",
      "comment-split": "psql -d app_dev -c 'DROP/**/DATABASE app_dev'",
      "dash-comment": "psql -d app_dev -c 'DROP--wipe\n  DATABASE app_dev'",
      "unlisted-client-comment": "pgcli -c 'DROP--wipe\n  DATABASE app_dev'",
      "backslash-newline": "psql -d app_dev -c \"DRO\\\nP DATA\\\nBASE app_dev\"",
      "double-newline": "psql -d app_dev -c \"DROP\n\nDATABASE app_dev\"",
      "single-quoted-backslash-newline": "psql -d app_dev -c 'DROP\\\nDATABASE app_dev'",
      "heredoc-backslash-newline": "psql -d app_dev <<'EOF'\nDROP\\\nDATABASE app_dev;\nEOF",
      "ask-beside-backslash-newline": "psql -d app_dev -c 'DROP\\\nDATABASE app_dev' -v x=\"$y\"",
      "comment-backslash-newline": "pgcli -c 'DROP --\\\nDATABASE app_dev'",
      "dash-comment-with-hyphen": "psql -d app_dev -c 'DROP--wipe-it\nDATABASE app_dev'",
      "block-comment-with-spaces": "psql -d app_dev -c 'DROP /* a b */ DATABASE app_dev'",
      "knex-with-option": "npx knex --knexfile db.js migrate:rollback --all"
    },
    "ask": {
      "brace-split": "psql -d app_dev -c \"DROP${IFS}DATABASE app_dev\"",
      "brace-list-piped": "echo {DROP,DATABASE} app_dev | psql -d app_dev",
      "spaced-line-comment": "psql -d app_dev -c 'DROP -- wipe it all\n  DATABASE app_dev'",
      "assembled-command": "psql -d app_dev -c \"$SQL\"",
      "construct-before-client": "echo \"$SQL\" | psql -d app_dev",
      "unlisted-client-brace": "pgcli -c \"DROP${IFS}DATABASE app_dev\"",
      "read-only-query": "psql -d app_dev -c 'select count(*) from users'",
      "star-in-query": "psql -c 'select * from users'",
      "migrate-verbose-flag": "pnpm run db:migrate -- --verbose",
      "drop-word-in-glob-search": "rg -n 'drop' src/*.ts",
      "mysql-hash-comment": "mysql -e 'DROP # c\nDATABASE app'"
    },
    "pass": {
      "search-word": "rg -n 'create table' src/",
      "migration-path": "cat migrations/0003_add_users.sql",
      "generate-migration": "pnpm drizzle-kit generate",
      "run-tests": "pnpm vitest run",
      "list-files": "ls -la"
    }
  },
