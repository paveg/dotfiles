{
  "db": {
    "rules": {
      "prisma-migrate-reset": {
        "tier": "deny",
        "fixtures": [
          "npx prisma migrate reset --force",
          "npx prisma migrate  reset"
        ]
      },
      "prisma-push-force-reset": {
        "tier": "deny",
        "fixtures": [
          "npx prisma db push --force-reset",
          "npx prisma db  push --force-reset"
        ]
      },
      "drizzle-push-force": {
        "tier": "deny",
        "fixtures": [
          "pnpm drizzle-kit push --force"
        ]
      },
      "rails-db-setup": {
        "tier": "deny",
        "fixtures": [
          "bin/rails db:setup",
          "bundle exec rake db:schema:load"
        ]
      },
      "django-flush": {
        "tier": "deny",
        "fixtures": [
          "python manage.py flush",
          "python manage.py reset_db"
        ]
      },
      "sequelize-undo-all": {
        "tier": "deny",
        "fixtures": [
          "npx sequelize db:migrate:undo:all"
        ]
      },
      "typeorm-schema-drop": {
        "tier": "deny",
        "fixtures": [
          "npx typeorm schema:drop"
        ]
      },
      "knex-rollback-all": {
        "tier": "deny",
        "fixtures": [
          "npx knex migrate:rollback --all"
        ]
      },
      "script-db-wipe": {
        "tier": "deny",
        "fixtures": [
          "pnpm run db:reset",
          "npx sequelize db:drop",
          "pnpm run db:nuke",
          "pnpm run db:wipe",
          "pnpm run db:clear"
        ]
      },
      "dropdb": {
        "tier": "deny",
        "fixtures": [
          "dropdb app_dev",
          "sudo -u postgres dropdb app"
        ]
      },
      "mysqladmin-drop": {
        "tier": "deny",
        "fixtures": [
          "mysqladmin drop app",
          "mysqladmin -u root drop app"
        ]
      },
      "drop-database": {
        "tier": "deny",
        "fixtures": [
          "psql -c \"DROP DATABASE app_dev\"",
          "psql -d app_dev -c 'dro\"p data\"base app_dev'",
          "psql -d app_dev -c \"DROP\nDATABASE app_dev\"",
          "psql -d app_dev -c 'DROP/**/DATABASE app_dev'",
          "pgcli -c 'DROP--wipe\n  DATABASE app_dev'",
          "psql -d app_dev -c \"DRO\\\nP DATA\\\nBASE app_dev\"",
          "psql -d app_dev -c \"DRO\\\nP DATA\\\nBASE app_dev\"",
          "psql -d app_dev -c 'DROP\\\nDATABASE app_dev'",
          "psql -d app_dev <<'EOF'\nDROP\\\nDATABASE app_dev;\nEOF",
          "psql -d app_dev -c 'DROP\\\nDATABASE app_dev' -v x=\"$y\"",
          "pgcli -c 'DROP --\\\nDATABASE app_dev'"
        ]
      },
      "drop-schema": {
        "tier": "deny",
        "fixtures": [
          "psql -d app_dev -c 'DROP SCHEMA public'"
        ]
      },
      "drop-table": {
        "tier": "deny",
        "fixtures": [
          "psql -d app_dev -c 'DROP TABLE users'"
        ]
      },
      "truncate": {
        "tier": "deny",
        "fixtures": [
          "psql -d app_dev -c 'TRUNCATE TABLE users'",
          "truncate -s 0 app.log"
        ]
      },
      "drop-expansion": {
        "tier": "ask",
        "fixtures": [
          "pgcli -c \"DROP${IFS}DATABASE app_dev\""
        ]
      },
      "drop-expansion-reversed": {
        "tier": "ask",
        "fixtures": [
          "echo {DROP,DATABASE} app_dev"
        ]
      },
      "client-construct": {
        "tier": "ask",
        "fixtures": [
          "psql -d app_dev -c \"$SQL\"",
          "mysql -e `cat query.sql`",
          "mariadb -e 'select * from users'",
          "sqlite3 app.db .t?bles",
          "prisma validate sch[1]ema.cfg",
          "drizzle-kit studio {a,b}",
          "pg_restore --list dump.tar",
          "pnpm run db:migrate -- --verbose",
          "mysql -e 'DROP # c\nDATABASE app'"
        ]
      },
      "client-construct-reversed": {
        "tier": "ask",
        "fixtures": [
          "echo '# header' | mysql -D app",
          "echo \"$SQL\" | psql -d app_dev",
          "echo `cat query.sql` | mysql -D app",
          "cat query* | mariadb app",
          "echo ? | sqlite3 app.db",
          "echo [x] | prisma validate",
          "echo {a,b} | drizzle-kit studio",
          "echo -- | pg_restore -d app",
          "echo $x && pnpm run db:migrate"
        ]
      },
      "client-after-brace": {
        "tier": "ask",
        "fixtures": [
          "echo {psql,x}",
          "echo {mysql,x}",
          "echo {mariadb,x}",
          "echo {sqlite3,x}",
          "echo {prisma,x}",
          "echo {drizzle-kit,x}",
          "echo {pg_restore,x}",
          "pnpm run {db:res,x}et"
        ]
      }
    },
    "deny": {
      "prisma-reset": "npx prisma migrate reset --force",
      "script-wrapper": "pnpm run db:reset",
      "rails-schema": "bin/rails db:schema:load",
      "postgres-cli": "dropdb app_dev",
      "sql-wipe-uppercase": "psql -d app_dev -c 'TRUNCATE TABLE users'",
      "sql-drop-db": "psql -c \"DROP DATABASE app_dev\"",
      "quote-split": "psql -d app_dev -c 'dro\"p data\"base app_dev'",
      "multiline": "psql -d app_dev -c \"DROP\n  DATABASE app_dev\"",
      "multiline-no-indent": "psql -d app_dev -c \"DROP\nDATABASE app_dev\"",
      "single-table": "psql -d app_dev -c 'DROP TABLE users'",
      "comment-split": "psql -d app_dev -c 'DROP/**/DATABASE app_dev'",
      "dash-comment": "psql -d app_dev -c 'DROP--wipe\n  DATABASE app_dev'",
      "unlisted-client-comment": "pgcli -c 'DROP--wipe\n  DATABASE app_dev'",
      "backslash-newline": "psql -d app_dev -c \"DRO\\\nP DATA\\\nBASE app_dev\"",
      "single-quoted-backslash-newline": "psql -d app_dev -c 'DROP\\\nDATABASE app_dev'",
      "heredoc-backslash-newline": "psql -d app_dev <<'EOF'\nDROP\\\nDATABASE app_dev;\nEOF",
      "ask-beside-backslash-newline": "psql -d app_dev -c 'DROP\\\nDATABASE app_dev' -v x=\"$y\"",
      "comment-backslash-newline": "pgcli -c 'DROP --\\\nDATABASE app_dev'"
    },
    "ask": {
      "brace-split": "psql -d app_dev -c \"DROP${IFS}DATABASE app_dev\"",
      "brace-list-piped": "echo {DROP,DATABASE} app_dev | psql -d app_dev",
      "spaced-line-comment": "psql -d app_dev -c 'DROP -- wipe it all\n  DATABASE app_dev'",
      "assembled-command": "psql -d app_dev -c \"$SQL\"",
      "construct-before-client": "echo \"$SQL\" | psql -d app_dev",
      "unlisted-client-brace": "pgcli -c \"DROP${IFS}DATABASE app_dev\"",
      "read-only-query": "psql -d app_dev -c 'select count(*) from users'",
      "star-in-query": "psql -c 'select * from users'",
      "migrate-verbose-flag": "pnpm run db:migrate -- --verbose",
      "drop-word-in-glob-search": "rg -n 'drop' src/*.ts",
      "mysql-hash-comment": "mysql -e 'DROP # c\nDATABASE app'"
    },
    "pass": {
      "search-word": "rg -n 'create table' src/",
      "migration-path": "cat migrations/0003_add_users.sql",
      "generate-migration": "pnpm drizzle-kit generate",
      "run-tests": "pnpm vitest run",
      "list-files": "ls -la"
    }
  },
  "sensitive": {
    "rules": {
      "name-ssh": {
        "tier": "deny",
        "fixtures": [
          "cat ~/.ssh/id_ed25519",
          "cat ~dev/.ssh/id_ed25519",
          "cat ./../.ssh/id_ed25519",
          "cat ~/.s\\\ns\\\nh/id_ed25519",
          "cat ~/.s\\\ns\\\nh/id_ed25519"
        ]
      },
      "name-aws": {
        "tier": "deny",
        "fixtures": [
          "cat ~/.aws/credentials"
        ]
      },
      "name-kube": {
        "tier": "deny",
        "fixtures": [
          "sed -n '1,40p' ~/.kube/config"
        ]
      },
      "name-kubeconfig": {
        "tier": "deny",
        "fixtures": [
          "cat ~/work/kubeconfig"
        ]
      },
      "name-gcloud": {
        "tier": "deny",
        "fixtures": [
          "cat ~/.config/gcloud/credentials.db"
        ]
      },
      "name-config-vault": {
        "tier": "deny",
        "fixtures": [
          "ls ~/.config/1password",
          "ls ~/.config/op",
          "ls ~/.config/keeper",
          "ls ~/.config/ksm",
          "tar -czf /tmp/state.tgz ~/.config/ghtkn"
        ]
      },
      "name-dot-vault": {
        "tier": "deny",
        "fixtures": [
          "cat ~/.1password/x",
          "cat ~/.keeper/x",
          "cat ~/.ghtkn/x"
        ]
      },
      "name-share-vault": {
        "tier": "deny",
        "fixtures": [
          "sqlite3 ~/.local/share/atuin/history.db .dump",
          "cat ~/.local/share/ghtkn/token"
        ]
      },
      "name-atuin": {
        "tier": "deny",
        "fixtures": [
          "cat ~/.atuin/config"
        ]
      },
      "name-claude-credentials": {
        "tier": "deny",
        "fixtures": [
          "cat ~/.claude/.credentials.json"
        ]
      },
      "name-codex-auth": {
        "tier": "deny",
        "fixtures": [
          "cat ~/.codex/auth.json"
        ]
      },
      "name-dotenv": {
        "tier": "deny",
        "fixtures": [
          "cat .env",
          "rg -n PASSWORD .env.production"
        ]
      },
      "fragment-expansion": {
        "tier": "ask",
        "fixtures": [
          "x=.ss; cat ~/${x}h/id_ed25519",
          "cat ~/.s`echo sh`/id_ed25519",
          "cat ~/.ss*/id_ed25519",
          "sed -n '1,5p' ~/.aw?/credentials",
          "cat ~/.s[s]h/id_ed25519",
          "cat ~/.s{s,x}h/id_ed25519"
        ]
      },
      "fragment-expansion-reversed": {
        "tier": "ask",
        "fixtures": [
          "cat $(echo ~/.s)sh/id_ed25519",
          "cat `echo x`.ss",
          "ls * .ss",
          "ls ? .ss",
          "ls [a] .ss",
          "ls {a,b} .ss"
        ]
      },
      "slash-dot-expansion": {
        "tier": "ask",
        "fixtures": [
          "ls ~/.$x",
          "ls ~/.`echo x`",
          "ls ~/.*",
          "ls ~/.?",
          "ls ~/.[a]sh",
          "tar -czf /tmp/state.tgz \"$HOME\"/.{ssh,aws}"
        ]
      },
      "word-dot-expansion": {
        "tier": "ask",
        "fixtures": [
          "cd && cat .{ssh,aws}/x",
          "cd; cat .{ssh,aws}/x",
          "cd || cat .{ssh,aws}/x",
          "pushd && cat .{ssh,aws}/x",
          "cd ~ && cat .{ssh,aws}/credentials",
          "cd $HOME && cat .{ssh,aws}/credentials",
          "cd ${HOME} && cat .{ssh,aws}/credentials",
          "cd ~/ && cat .{ssh,aws}/credentials",
          "cd -- ~ && cat .{ssh,aws}/x",
          "cd -P ~ && cat .{ssh,aws}/x",
          "cd ~dev && cat .{ssh,aws}/x",
          "cd /Users/dev && cat .{ssh,aws}/x",
          "cd >/dev/null && cat .{ssh,aws}/x",
          "cd # go home\ncat .{ssh,aws}/x",
          "cd\ncat .{ssh,aws}/x",
          "pushd \"$HOME\" && cat .{ssh,aws}/x",
          "cat .{ssh,aws}/x",
          "cat .$dir/x",
          "cat .`echo ssh`/x",
          "cat .?sh/id_ed25519"
        ]
      },
      "dot-paren-glob": {
        "tier": "ask",
        "fixtures": [
          "cat ~/.s(s)h/id_ed25519",
          "cat ~/.a(w)s/credentials",
          "cat .e(n)v",
          "cat ~/.(ssh|aws)/config"
        ]
      },
      "glued-variable-name": {
        "tier": "ask",
        "fixtures": [
          "cat ~/$x.ssh/id_ed25519",
          "cat ~/$x.aws/credentials",
          "cat ~/$x.kube/config",
          "cat ~/$x.config/gcloud/credentials.db",
          "cat ~/$x.config/1password/x",
          "cat ~/$x.config/op/x",
          "cat ~/$x.config/keeper/x",
          "cat ~/$x.config/ksm/x",
          "cat ~/$x.config/ghtkn/x",
          "cat ~/$x.1password/x",
          "cat ~/$x.keeper/x",
          "cat ~/$x.ghtkn/x",
          "cat ~/$x.local/share/ghtkn/token",
          "cat ~/$x.local/share/atuin/history.db",
          "cat ~/$x.atuin/config",
          "cat ~/$x.codex/auth.json",
          "cat ~/$x.env",
          "cat ~/$base.ssh/id_ed25519"
        ]
      },
      "kubeconfig-expansion": {
        "tier": "ask",
        "fixtures": [
          "cat kubeconfig-p*"
        ]
      },
      "kubeconfig-expansion-reversed": {
        "tier": "ask",
        "fixtures": [
          "cat $DIR/kubeconfig-prod",
          "echo {kubeconfig-a,b}"
        ]
      }
    },
    "deny": {
      "remote-login-dir": "cat ~/.ssh/id_ed25519",
      "cloud-profile": "grep -n aws_access_key_id $HOME/.aws/credentials",
      "cluster-config": "sed -n '1,40p' ${HOME}/.kube/config",
      "vault-tooling": "tar -czf /tmp/state.tgz ~/.config/ghtkn",
      "agent-login": "cat ~/.claude/.credentials.json",
      "history-db": "sqlite3 ~/.local/share/atuin/history.db .dump",
      "absolute-home": "install -m 600 /home/dev/.aws/credentials /tmp/copy",
      "other-user-home": "cat ~dev/.ssh/id_ed25519",
      "double-slash": "sed -n '1,5p' //Users/dev/.aws/credentials",
      "relative-parent": "cat ./../.ssh/id_ed25519",
      "command-substitution": "cat \"$(echo ~)/.ssh/id_ed25519\"",
      "repo-copy": "cat home/.ssh/config",
      "repo-vault-config": "cat home/.config/ghtkn/gh-app.personal",
      "dotenv": "cat .env",
      "dotenv-variant": "rg -n PASSWORD .env.production",
      "dotenv-unlisted-suffix": "cat .env.ci",
      "dotenv-custom-suffix": "cat .env.docker",
      "dotenv-strict-prefix": "cat .env.exam",
      "dotenv-single-char": "cat .env.s",
      "dotenv-template-lookalike": "cat .env.examplebak",
      "exempt-token-tail": "cat ~/.ssh/id_ed25519>/tmp/x.env.example",
      "template-then-real": "cat ~/.env.example;cat ~/.env",
      "backslash-split": "cat ~/.s\\sh/id_ed25519",
      "single-quote-split": "cat ~/.s's'h/id_ed25519",
      "double-quote-split": "cat ~/.s\"s\"h/id_ed25519",
      "backslash-newline": "cat ~/.s\\\ns\\\nh/id_ed25519"
    },
    "ask": {
      "bare-cd-then-glob": "cd && cat .{ssh,aws}/x",
      "bare-cd-semicolon": "cd; cat .{ssh,aws}/x",
      "bare-cd-or": "cd || cat .{ssh,aws}/x",
      "bare-pushd": "pushd && cat .{ssh,aws}/x",
      "variable-glued-before-ssh": "cat ~/$x.ssh/id_ed25519",
      "variable-glued-before-aws": "cat ~/$x.aws/credentials",
      "brace-expansion": "tar -czf /tmp/state.tgz \"$HOME\"/.{ssh,aws}",
      "glob-fragment": "cat ~/.ss*/id_ed25519",
      "glob-fragment-bare": "cat ~/.ss*",
      "brace-fragment": "cat ~/.s{s,x}h/id_ed25519",
      "question-fragment": "sed -n '1,5p' ~/.aw?/credentials",
      "variable-stem": "x=.ss; cat ~/${x}h/id_ed25519",
      "cd-home-brace": "cd ~ && cat .{ssh,aws}/credentials",
      "dotdir-glob": "ls .github/workflows/*.yml",
      "config-glob": "ls ~/.config/*",
      "paren-glob": "cat ~/.s(s)h/id_ed25519",
      "dot-brace-no-cd": "cat .{ssh,aws}/x",
      "pushd-home-brace": "pushd ~ && cat .{ssh,aws}/x",
      "cd-newline-brace": "cd\ncat .{ssh,aws}/x"
    },
    "pass": {
      "read-readme": "cat README.md",
      "variable-with-extension": "cat $FILE.json",
      "aws-cli": "aws s3 ls s3://bucket/prefix",
      "cluster-query": "kubectl get pods -n default",
      "glob-in-dir": "rg -n TODO src/*.ts",
      "home-glob": "ls ~/repos/paveg/*",
      "flake-attr": "nix build .#block-destructive-db",
      "regex-dot-star": "rg -n 'import .* from' src/",
      "sed-expression": "sed -n 's/^.*=//p' notes.txt",
      "brace-extensions": "prettier --check \"src/**/*.{ts,tsx}\"",
      "parent-glob": "ls ../*",
      "agent-socket": "echo $SSH_AUTH_SOCK",
      "cluster-flag": "kubectl --kubeconfig=./dev.yaml get pods",
      "stem-with-glob": "grep -r ssh *.md",
      "direnv-file": "cat .envrc",
      "dotenv-template": "cat .env.example",
      "dotenv-sample": "cat .env.sample",
      "dotenv-template-arg": "op run --env-file=.env.example -- just serve",
      "dotenv-template-word": "cat .env.template",
      "dotenv-template-twice": "diff .env.example apps/web/.env.example",
      "vault-run": "op run --env-file=config/local.env -- just serve",
      "vault-exec": "ksm exec -- gh pr list",
      "ghtkn-exec": "ghtkn exec -- gh pr list",
      "remote-login": "ssh personal-mac uptime",
      "list-files": "ls -la",
      "dotenv-template-at-start": ".env.example"
    }
  },
  "ordinary": [
    "ls -la",
    "git status",
    "git log --oneline -5",
    "git diff --stat",
    "cat README.md",
    "cat package.json",
    "rg -n TODO src/*.ts",
    "find . -name '*.ts'",
    "grep -r foo src/",
    "pnpm vitest run",
    "npm run build -- --watch",
    "cargo test -- --nocapture",
    "just test",
    "nix build .#foo",
    "docker compose up -d",
    "kubectl get pods -n default",
    "aws s3 ls",
    "tar -czf out.tgz dist/",
    "echo $HOME",
    "ls .github/workflows/*.yml",
    "ls ~/.config/*",
    "ls ~/.ssh",
    "psql -c 'select * from users'",
    "pnpm run db:migrate -- --verbose",
    "rg -n 'drop' src/*.ts"
  ]
}
