    { "id": "command_block_text", "type": "text", "x": 52, "y": 227, "width": 536, "height": 18, "text": "$ curl -fsSL .../bootstrap.sh | bash -s -- personal-mac", "originalText": "$ curl -fsSL .../bootstrap.sh | bash -s -- personal-mac", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#e5e7eb", "opacity": 100, "lineHeight": 1.25, "seed": 1061 },

