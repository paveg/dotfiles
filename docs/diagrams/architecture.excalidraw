    { "id": "personal_layers", "type": "text", "x": 120, "y": 430, "width": 300, "height": 105, "text": "nix-darwin + nix-homebrew\n  apps: 1Password, Raycast, Ghostty\n  casks: Orca (tap), Karabiner\nhome-manager\nTailscale + orca serve\n  reachable from the phone", "originalText": "nix-darwin + nix-homebrew\n  apps: 1Password, Raycast, Ghostty\n  casks: Orca (tap), Karabiner\nhome-manager\nTailscale + orca serve\n  reachable from the phone", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4b5563", "opacity": 100, "lineHeight": 1.25, "seed": 2060 },
    { "id": "work_layers", "type": "text", "x": 560, "y": 430, "width": 300, "height": 105, "text": "nix-darwin + nix-homebrew\nhome-manager\nwork profile from Keeper\n  ~/.config/dots-work/\ncorporate CA for Nix fetches\nno Tailscale", "originalText": "nix-darwin + nix-homebrew\nhome-manager\nwork profile from Keeper\n  ~/.config/dots-work/\ncorporate CA for Nix fetches\nno Tailscale", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4b5563", "opacity": 100, "lineHeight": 1.25, "seed": 2061 },
    { "id": "wsl_layers", "type": "text", "x": 1000, "y": 430, "width": 300, "height": 105, "text": "home-manager (standalone)\nWindows side, by winget:\n  1Password + op.exe\n  Orca, Raycast\n  Windows Terminal\nssh.exe through WSL interop", "originalText": "home-manager (standalone)\nWindows side, by winget:\n  1Password + op.exe\n  Orca, Raycast\n  Windows Terminal\nssh.exe through WSL interop", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4b5563", "opacity": 100, "lineHeight": 1.25, "seed": 2062 },

    { "id": "divider_common", "type": "line", "x": 40, "y": 580, "width": 1300, "height": 0, "points": [[0, 0], [1300, 0]], "strokeColor": "#6b7280", "strokeWidth": 1, "roughness": 0, "opacity": 100, "seed": 3001 },
    { "id": "common_heading", "type": "text", "x": 40, "y": 600, "width": 300, "height": 25, "text": "On every host", "originalText": "On every host", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#111827", "opacity": 100, "lineHeight": 1.25, "seed": 3002 },

    { "id": "config_heading", "type": "text", "x": 40, "y": 645, "width": 400, "height": 20, "text": "Config: plain files in home/", "originalText": "Config: plain files in home/", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1d4ed8", "opacity": 100, "lineHeight": 1.25, "seed": 3010 },
    { "id": "config_body", "type": "text", "x": 40, "y": 675, "width": 400, "height": 70, "text": "zsh: ~/.zshenv sets ZDOTDIR\ngit, nvim, ghostty, atuin\nClaude Code + Codex config\nlinked with mkOutOfStoreSymlink", "originalText": "zsh: ~/.zshenv sets ZDOTDIR\ngit, nvim, ghostty, atuin\nClaude Code + Codex config\nlinked with mkOutOfStoreSymlink", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4b5563", "opacity": 100, "lineHeight": 1.25, "seed": 3011 },

    { "id": "tools_heading", "type": "text", "x": 500, "y": 645, "width": 400, "height": 20, "text": "Tools: Nix first (P8)", "originalText": "Tools: Nix first (P8)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1d4ed8", "opacity": 100, "lineHeight": 1.25, "seed": 3020 },
    { "id": "tools_body", "type": "text", "x": 500, "y": 675, "width": 400, "height": 70, "text": "module > nixpkgs > cask > manual\none flake.lock for every host\nproject tools: mise shims\nTLA+ / Lean: flake templates", "originalText": "module > nixpkgs > cask > manual\none flake.lock for every host\nproject tools: mise shims\nTLA+ / Lean: flake templates", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4b5563", "opacity": 100, "lineHeight": 1.25, "seed": 3021 },

    { "id": "secrets_heading", "type": "text", "x": 960, "y": 645, "width": 380, "height": 20, "text": "Secrets stay in vaults", "originalText": "Secrets stay in vaults", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#6d28d9", "opacity": 100, "lineHeight": 1.25, "seed": 3030 },
    { "id": "secrets_body", "type": "text", "x": 960, "y": 675, "width": 380, "height": 70, "text": "1Password: personal, SSH, signing\nKeeper: work secrets + config\nghtkn: short-lived GitHub tokens\nnothing secret in this repo", "originalText": "1Password: personal, SSH, signing\nKeeper: work secrets + config\nghtkn: short-lived GitHub tokens\nnothing secret in this repo", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4b5563", "opacity": 100, "lineHeight": 1.25, "seed": 3031 },

    { "id": "ci_footer", "type": "text", "x": 40, "y": 790, "width": 1300, "height": 18, "text": "Planned CI: shell tests in a temp HOME, bootstrap tests with stubbed human steps, TLC on spec/*.tla", "originalText": "Planned CI: shell tests in a temp HOME, bootstrap tests with stubbed human steps, TLC on spec/*.tla", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#15803d", "opacity": 100, "lineHeight": 1.25, "seed": 3040 }
